{
  "name": "figma-forge",
  "version": "0.0.0",
  "private": true,
  "description": "Free, two-way Figma MCP server. Turn designs into framework-aware code, and push code back to the canvas. Works with Claude Code, Cursor, Codex, and any MCP client.",
  "homepage": "https://github.com/vukiman1/figma-forge",
  "bugs": {
    "url": "https://github.com/vukiman1/figma-forge/issues"
  },
  "license": "MIT",
  "author": "vukiman1",
  "repository": {
    "type": "git",
    "url": "https://github.com/vukiman1/figma-forge.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "pnpm -r exec rm -rf dist *.tsbuildinfo",
    "comments:check": "node scripts/check-comments.ts --check 'scripts/*.ts' 'packages/core/**/*.ts' 'packages/server/**/*.ts' 'packages/plugin/**/*.ts'",
    "comments:report": "node scripts/check-comments.ts --report 'packages/**/*.ts'",
    "deps:check": "depcruise packages --config .dependency-cruiser.json",
    "dev": "pnpm -r --parallel run dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "lint": "oxlint --deny-warnings . && oxlint --type-aware --deny-warnings -c .oxlintrc.strict.json scripts packages",
    "lint:fix": "oxlint --fix .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck && tsc -p scripts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.7.0",
    "knip": "^6.43.0",
    "oxc-parser": "^0.155.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.15.0"
}
