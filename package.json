{
  "name": "figma-forge",
  "version": "0.1.0",
  "private": true,
  "description": "Free, two-way Figma MCP server. Turn designs into framework-aware code, and push code back to the canvas. Works with Claude Code, Cursor, Codex, and any MCP client.",
  "homepage": "https://github.com/vukiman1/figma-forge",
  "bugs": {
    "url": "https://github.com/vukiman1/figma-forge/issues"
  },
  "license": "MIT",
  "author": "vukiman1",
  "repository": {
    "type": "git",
    "url": "https://github.com/vukiman1/figma-forge.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build && node scripts/pack-server-assets.ts",
    "clean": "pnpm -r exec rm -rf dist *.tsbuildinfo",
    "comments:check": "node scripts/check-comments.ts --check 'scripts/*.ts' 'packages/core/**/*.ts' 'packages/plugin/**/*.ts' 'packages/server/src/election/**/*.ts' 'packages/server/src/routing/**/*.ts' 'packages/server/src/relay/**/*.ts' 'packages/server/src/profile/**/*.ts' 'packages/server/src/scan/**/*.ts' 'packages/server/src/optional-file.ts' 'packages/server/src/parse-source.ts' 'packages/server/src/{build-id,ignored-dirs,instructions,local-access,node-id,process-guard-install}.ts' 'packages/server/src/repo-*.ts' 'packages/server/src/diff/**/*.ts' 'packages/server/src/icons/**/*.ts' 'packages/server/src/join/**/*.ts' 'packages/server/src/prompts/**/*.ts' 'packages/server/src/tools/design-context-*.ts' 'packages/server/src/tools/{annotations,binary-payload,notices,result-budget,wire-schema}.ts' 'packages/server/src/tokens/hex.ts' 'packages/server/src/tokens/generated-token-note.ts' 'packages/server/src/tokens/generated-tokens.ts' 'packages/server/src/tokens/figma-token.ts' 'packages/server/src/tokens/figma-token-value.ts' 'packages/server/src/tokens/figma-tokens.ts' 'packages/server/src/tokens/figma-variable-resolver.ts' 'packages/server/src/tokens/js-config-token-loader.ts' 'packages/server/src/tokens/load.ts' 'packages/server/src/tokens/load-result.ts' 'packages/server/src/tokens/project-token.ts' 'packages/server/src/tokens/read-token-file.ts' 'packages/server/src/tokens/scss-token-pool.ts' 'packages/server/src/tokens/token-source.ts' 'packages/server/src/tokens/token-annotation.ts' 'packages/server/src/tokens/token-index.ts' 'packages/server/src/tokens/token-index-cache.ts' 'packages/server/src/tokens/token-value-index.ts' 'packages/server/src/tokens/js-config/**/*.ts' 'packages/server/src/tokens/stylesheet/**/*.ts' 'packages/server/src/error-message.ts' 'packages/server/src/parse-json.ts' 'packages/server/test/election/**/*.ts' 'packages/server/test/routing/**/*.ts' 'packages/server/test/relay/**/*.ts' 'packages/server/test/profile/**/*.ts' 'packages/server/test/scan/**/*.ts' 'packages/server/test/tokens/hex.test.ts' 'packages/server/test/tokens/js-config/**/*.ts' 'packages/server/test/tokens/project-token.test.ts' 'packages/server/test/tokens/stylesheet/**/*.ts'",
    "comments:report": "node scripts/check-comments.ts --report 'packages/**/*.ts'",
    "deps:check": "depcruise packages --config .dependency-cruiser.json",
    "dev": "pnpm -r --parallel run dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "lint": "oxlint --deny-warnings . && oxlint --type-aware --deny-warnings -c .oxlintrc.strict.json scripts packages",
    "lint:fix": "oxlint --fix .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck && tsc -p scripts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.7.0",
    "knip": "^6.43.0",
    "oxc-parser": "^0.155.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.15.0"
}
