{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./.oxlintrc.json"],
  "rules": {
    "max-lines": [
      "error",
      {
        "max": 150,
        "skipBlankLines": true
      }
    ],
    "max-lines-per-function": [
      "error",
      {
        "max": 40,
        "skipBlankLines": true
      }
    ],
    "max-depth": [
      "error",
      {
        "max": 2
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-type-assertion": "error"
  },
  "overrides": [
    {
      "files": ["**/test/**", "**/*.test.ts"],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 300,
            "skipBlankLines": true
          }
        ],
        "max-lines-per-function": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/unbound-method": "off",
        "max-depth": [
          "error",
          {
            "max": 4
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "packages/mcp/**",
    "packages/plugin/ui/**",
    "packages/plugin/protocol/**",
    "packages/plugin/*.ts",
    "test/**",
    "packages/plugin/src/*.ts",
    "packages/plugin/test/*.ts",
    "packages/plugin/test/components/**",
    "packages/plugin/test/composables/**",
    "packages/plugin/test/lib/**",
    "packages/plugin/test/protocol/**",
    "packages/plugin/test/relay/**",
    "packages/plugin/test/sandbox/**"
  ]
}
