{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./.oxlintrc.json"],
  "rules": {
    "max-lines": [
      "error",
      {
        "max": 150,
        "skipBlankLines": true
      }
    ],
    "max-lines-per-function": [
      "error",
      {
        "max": 40,
        "skipBlankLines": true
      }
    ],
    "max-depth": [
      "error",
      {
        "max": 2
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-type-assertion": "error"
  },
  "overrides": [
    {
      "files": ["**/test/**", "**/*.test.ts"],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 300,
            "skipBlankLines": true
          }
        ],
        "max-lines-per-function": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/unbound-method": "off",
        "max-depth": [
          "error",
          {
            "max": 4
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "packages/server/**",
    "!packages/server/src/",
    "!packages/server/src/routing/**",
    "!packages/server/src/election/**",
    "!packages/server/src/relay/**",
    "!packages/server/src/profile/**",
    "!packages/server/src/scan/**",
    "!packages/server/src/optional-file.ts",
    "!packages/server/src/parse-source.ts",
    "!packages/server/src/node-id.ts",
    "!packages/server/src/local-access.ts",
    "!packages/server/src/build-id.ts",
    "!packages/server/src/ignored-dirs.ts",
    "!packages/server/src/instructions.ts",
    "!packages/server/src/icons/**",
    "!packages/server/src/prompts/**",
    "!packages/server/src/tools/design-context-*.ts",
    "!packages/server/src/tools/annotations.ts",
    "!packages/server/src/tools/binary-payload.ts",
    "!packages/server/src/tools/result-budget.ts",
    "!packages/server/src/tools/notices.ts",
    "!packages/server/src/tools/wire-schema.ts",
    "!packages/server/src/process-guard-install.ts",
    "!packages/server/src/repo-*.ts",
    "!packages/server/src/diff/**",
    "!packages/server/src/join/**",
    "!packages/server/src/tokens/hex.ts",
    "!packages/server/src/tokens/generated-token-note.ts",
    "!packages/server/src/tokens/generated-tokens.ts",
    "!packages/server/src/tokens/figma-token.ts",
    "!packages/server/src/tokens/figma-token-value.ts",
    "!packages/server/src/tokens/figma-tokens.ts",
    "!packages/server/src/tokens/figma-variable-resolver.ts",
    "!packages/server/src/tokens/js-config-token-loader.ts",
    "!packages/server/src/tokens/load.ts",
    "!packages/server/src/tokens/load-result.ts",
    "!packages/server/src/tokens/project-token.ts",
    "!packages/server/src/tokens/read-token-file.ts",
    "!packages/server/src/tokens/scss-token-pool.ts",
    "!packages/server/src/tokens/token-source.ts",
    "!packages/server/src/tokens/token-annotation.ts",
    "!packages/server/src/tokens/token-index.ts",
    "!packages/server/src/tokens/token-index-cache.ts",
    "!packages/server/src/tokens/token-value-index.ts",
    "!packages/server/src/tokens/js-config/**",
    "!packages/server/src/tokens/stylesheet/**",
    "!packages/server/src/error-message.ts",
    "!packages/server/src/parse-json.ts",
    "!packages/server/test/",
    "!packages/server/test/routing/**",
    "!packages/server/test/election/**",
    "!packages/server/test/relay/**",
    "!packages/server/test/profile/**",
    "!packages/server/test/scan/**",
    "!packages/server/test/tokens/hex.test.ts",
    "!packages/server/test/tokens/js-config/**",
    "!packages/server/test/tokens/project-token.test.ts",
    "!packages/server/test/tokens/stylesheet/**",
    "test/**"
  ]
}
