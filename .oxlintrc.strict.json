{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./.oxlintrc.json"],
  "rules": {
    "max-lines": [
      "error",
      {
        "max": 150,
        "skipBlankLines": true
      }
    ],
    "max-lines-per-function": [
      "error",
      {
        "max": 40,
        "skipBlankLines": true
      }
    ],
    "max-depth": [
      "error",
      {
        "max": 2
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-type-assertion": "error"
  },
  "overrides": [
    {
      "files": ["**/test/**", "**/*.test.ts"],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 300,
            "skipBlankLines": true
          }
        ],
        "max-lines-per-function": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/unbound-method": "off",
        "max-depth": [
          "error",
          {
            "max": 4
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "packages/server/**",
    "!packages/server/src/",
    "!packages/server/src/routing/**",
    "!packages/server/src/election/**",
    "!packages/server/src/relay/**",
    "!packages/server/src/error-message.ts",
    "!packages/server/src/parse-json.ts",
    "!packages/server/test/",
    "!packages/server/test/routing/**",
    "!packages/server/test/election/**",
    "!packages/server/test/relay/**",
    "test/**"
  ]
}
